# ==============================================================================
# Waleed's Personal Document Hub - Environment Variables
# ==============================================================================
# IMPORTANT SECURITY GUIDELINES:
# 1. Copy this file to `.env` for local development.
# 2. NEVER commit `.env` or paste real credentials into GitHub!
# 3. Only the Supabase Project URL and Anon (Publishable) Key should be provided here.
# 4. NEVER use the Supabase Service-Role Key in client-side code!
# ==============================================================================

# Supabase Project URL (e.g., https://your-project-id.supabase.co)
VITE_SUPABASE_URL=https://your-project-id.supabase.co

# Supabase Anonymous Publishable Key (safe for browser with Row Level Security)
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Optional: Inactivity auto-logout timeout in minutes (default is 15 minutes)
VITE_INACTIVITY_TIMEOUT_MINUTES=15
